{
    "id": "set_holiday_schedule_enabled_iqc",
    "title": {
        "en": "Set holiday schedule"
    },
    "titleFormatted": {
        "en": "Set holiday schedule to [[state]]"
    },
    "args": [
        {
            "name": "device",
            "type": "device",
            "filter": "driver_id=iqc-touch"
        },
        {
            "name": "state",
            "type": "dropdown",
            "title": {
                "en": "State"
            },
            "required": true,
            "values": [
                {
                    "id": "0",
                    "label": {
                        "en": "Disabled"
                    }
                },
                {
                    "id": "1",
                    "label": {
                        "en": "Enabled"
                    }
                }
            ]
        }
    ]
}
