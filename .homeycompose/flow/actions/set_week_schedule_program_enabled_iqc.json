{
    "id": "set_week_schedule_program_enabled_iqc",
    "title": {
        "en": "Set week schedule program"
    },
    "titleFormatted": {
        "en": "Set week schedule program [[program]] to [[state]]"
    },
    "args": [
        {
            "name": "device",
            "type": "device",
            "filter": "driver_id=iqc-touch"
        },
        {
